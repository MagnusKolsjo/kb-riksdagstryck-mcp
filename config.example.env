# =============================================================================
# config.example.env — Mall för konfiguration
# Kopiera den här filen till .env och fyll i dina egna värden.
# .env checkas ALDRIG in i Git (se .gitignore).
# =============================================================================

# ── Databasanslutning ──────────────────────────────────────────────────────────
# Skripten och MCP-servern läser en enda variabel, DATABASE_URL. Den ersätter de
# separata PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD som tidigare användes.
#
# PostgreSQL (rekommenderas — krävs för vektorsökning)
DATABASE_URL=postgresql://mitt_db_anvandare:byt_till_eget_starkt_losenord@localhost:5432/riksdag

# SQLite (alternativ utan vektorsökning — begränsad funktionalitet)
# DATABASE_URL=sqlite:///kb_riksdagstryck_cache.db

# ── Databas via Docker (valfritt) ──────────────────────────────────────────────
# Behövs BARA om du startar PostgreSQL med den medföljande docker-compose.yml.
# Kör du en egen PostgreSQL — t.ex. en systeminstallation — kan hela det här
# avsnittet lämnas orört; då räcker DATABASE_URL ovan.
#
# Docker Compose substituerar variablerna nedan i docker-compose.yml och skapar
# databasen och användaren vid första start. De måste stämma överens med
# DATABASE_URL ovan, annars pekar servern på en databas som inte finns.
#
# OBS: POSTGRES_PASSWORD är obligatorisk för postgres-imagen. Lämnas PGPASSWORD
# tomt vägrar containern starta.
PGDATABASE=riksdag
PGUSER=mitt_db_anvandare
PGPASSWORD=byt_till_eget_starkt_losenord

# Värdport som containern exponeras på (containerns interna port är alltid 5432).
PGPORT=5432

# ── Filsökvägar ────────────────────────────────────────────────────────────────
# Sökväg där nedladdade XML-filer lagras lokalt
XML_RAW_DIR=./xml_raw

# Sökväg där PDF-filer lagras (de 16 PDF-only volymerna)
PDF_RAW_DIR=./pdf_raw

# ── Embeddingmodell ────────────────────────────────────────────────────────────
# KBLab/sentence-bert-swedish-cased är tränad specifikt för semantisk likhet
# (knowledge distillation från all-mpnet-base-v2) och ger bättre sökresultat
# än den generella KBLab/bert-base-swedish-cased. Körs lokalt, ingen API-nyckel.
EMBEDDING_MODEL=KBLab/sentence-bert-swedish-cased

# ── Textutdrag i sökresultat ───────────────────────────────────────────────────
# Ett textstycke i databasen är ungefär 600 ord — flera tusen tecken. Utan tak
# blir ett sökresultat med tjugo träffar mycket stort, så utdragen kapas vid
# teckentaket nedan. Kapningen sker alltid på ordgräns och markeras i svaret med
# hur mycket som visas av hur mycket; hela texten hämtas med kb_get_chunk.
#
# Sätt värdet till 0 för att stänga av trunkeringen helt. Enskilda anrop kan
# alltid överstyra taket med parametern max_tecken.

# Teckentak per träff i kb_search
KB_MAX_TECKEN_TRAFF=1500

# Teckentak för volymutdraget i kb_get_volume
KB_MAX_TECKEN_UTDRAG=2000

# ── Nedladdning ────────────────────────────────────────────────────────────────
# Antal sekunder paus mellan nedladdningar (var snäll mot KB:s server)
DOWNLOAD_DELAY=0.5

# Max antal nätverksfel innan nedladdning avbryts
MAX_ERRORS=10

# ── Transport och autentisering ────────────────────────────────────────────────
# Transport: "stdio" (lokal, standardläge) eller "http" (hostad driftsättning).
MCP_TRANSPORT=stdio

# Värdadress och port för HTTP-transporten (används bara om MCP_TRANSPORT=http).
MCP_HOST=127.0.0.1
MCP_PORT=8000

# API-nyckel för HTTP-transporten. Krävs när MCP_TRANSPORT=http — servern
# vägrar starta utan den (fail-closed).
# Generera: python3 -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEY=

# ── Query-expansion (valfritt) ─────────────────────────────────────────────────
# Aktivera för att låta ett LLM utöka söktermen med historiska stavningsvarianter
# och latinska ekvivalenter innan databasfrågan körs.
#
# Stöder alla OpenAI-kompatibla endpoints:
#   Anthropic: QUERY_EXPANSION_BASE_URL=https://api.anthropic.com/v1
#   OpenAI:    lämna QUERY_EXPANSION_BASE_URL tomt (standard)
#   Ollama:    QUERY_EXPANSION_BASE_URL=http://localhost:11434/v1
#   LM Studio: QUERY_EXPANSION_BASE_URL=http://localhost:1234/v1
#
# Promptfilen i prompts/expansion_prompt.txt kan redigeras för att anpassa
# expansionen. Den kan också användas som grund för en MCP-skill — se README.
QUERY_EXPANSION_ENABLED=false
QUERY_EXPANSION_BASE_URL=
QUERY_EXPANSION_API_KEY=
QUERY_EXPANSION_MODEL=<modellnamn>
# QUERY_EXPANSION_PROMPT_FILE=./prompts/expansion_prompt.txt  # standard, ändra vid behov
